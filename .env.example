# Spotify app credentials from https://developer.spotify.com/dashboard
# Demo mode works without these values.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/api/auth/callback

# Frontend origin used after OAuth redirect
FRONTEND_ORIGIN=http://127.0.0.1:4177

# Signed session cookies and optional token encryption
SESSION_SECRET=change-me-to-a-long-random-string

# SQLite by default. Swap the URL for PostgreSQL later:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/listening_graph
DATABASE_URL=sqlite:///./data/local/listening_graph.db

# Sessionization: start a new listening session after this many minutes of inactivity
SESSION_GAP_MINUTES=30

# Optional CORS extra origins (comma-separated)
CORS_ORIGINS=http://127.0.0.1:4177,http://localhost:4177

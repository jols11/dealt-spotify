# Spotify Dashboard → your app → Settings
# No quotes, no spaces around =
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Local development
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/api/auth/callback
FRONTEND_ORIGIN=http://127.0.0.1:4177

# Production (same host for UI + API). When set, OAuth redirect becomes
# {PUBLIC_BASE_URL}/api/auth/callback — add that URI in the Spotify Dashboard too.
# PUBLIC_BASE_URL=https://your-domain.example

SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/local/listening_graph.db
SESSION_GAP_MINUTES=30
CORS_ORIGINS=http://127.0.0.1:4177,http://localhost:4177,http://127.0.0.1:8765,http://localhost:8765
